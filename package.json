    "@angular/platform-browser-dynamic": "^20.3.34",
    "@angular/platform-server": "^20.3.34",
    "@angular/router": "^20.3.34",
    "@angular/ssr": "^20.3.40",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "express": "^4.18.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
