  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration=production --base-href=/ --deploy-url=/",
    "build:ghpages": "ngh --dir=dist/ingaamira.github.io/browser",
